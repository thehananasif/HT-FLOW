{
  "name": "htflow",
  "private": true,
  "version": "0.1.0",
  "description": "HT Flow — professional order-flow trading platform for Windows",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @htflow/desktop tauri dev",
    "dev:web": "pnpm --filter @htflow/desktop dev",
    "build": "pnpm --filter @htflow/desktop tauri build",
    "build:web": "pnpm --filter @htflow/desktop build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @htflow/desktop e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
